# Build artifacts
/target/
debug/
release/

# Web demo build output (scripts/build-web.sh writes these into web/site/)
/web/site/src/wasm/
/web/site/assets/

# The demo as the docs site serves it; gh-pages.yml builds it into the
# deployment, so a local copy is never the thing that gets published
/docs/demo/

# macOS packaging output (scripts/package-macos.sh writes these into the
# repository root; CI uploads them as release assets)
/CloudBridge.app/
/dmg-root/
/cloudbridge-macos-*.dmg
/cloudbridge-windows-*.exe

# Cargo lock file (optional for applications, keep it)
# Cargo.lock

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Environment and local config
.env
.env.local
*.local

# Logs
*.log
logs/

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.bak

# User data (contains encrypted credentials - never commit!)
*.duckdb
*.duckdb.wal
config.json
scripts/.venv/
